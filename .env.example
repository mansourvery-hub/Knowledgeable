# Knowledgeable — copy to `.env` and adjust. Only the first four entries are
# required; without provider keys the offline `local-tutor` fallback serves.
DATABASE_URL=sqlite:knowledgeable.db
PORT=3000
HOST=0.0.0.0
RUST_LOG=info

# --- Model providers (all optional; uncomment what you use) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Production web build override (optional) ---
# WEB_DIST_DIR=/absolute/path/to/apps/web/client/dist

# --- Public deployment gate (optional, off unless set) ---
# When set, every /api/*, /v1/* (except health probes) and /debug/* path
# requires `Authorization: Bearer <token>`; health probes and the static web
# shell stay open. Leave unset for local dev. Generate with:
#   openssl rand -hex 32
# NOTE: the web/phone clients cannot send this token yet — enabling the gate
# is currently for curl-gated testers, not end users.
# PUBLIC_API_TOKEN=
