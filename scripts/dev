#!/usr/bin/env bash
# Unified developer runner (M10): backend :3000 + Vite web client :3090.
#
#   ./scripts/dev            # backend + web, foreground, Ctrl-C stops both
#   ./scripts/dev --backend-only
#
# Contract:
# - Run from the repo root (uses ./apps/web, ./target, ./.env).
# - Backend reads .env (PORT, DATABASE_URL, provider keys); Vite proxies
#   /api to BACKEND_PORT. The two must agree, so this script exports
#   BACKEND_PORT from PORT (default 3000).
# - No external services: SQLite + optional local/Ollama or provider keys.
set -euo pipefail

MODE="${1:-all}"
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR"

BACKEND_ONLY=0
if [ "$MODE" = "--backend-only" ]; then
  BACKEND_ONLY=1
elif [ "$MODE" != "all" ]; then
  echo "usage: ./scripts/dev [all|--backend-only]" >&2
  exit 2
fi

command -v cargo >/dev/null 2>&1 || { echo "missing: cargo (rustup.rs)" >&2; exit 1; }
if [ "$BACKEND_ONLY" -eq 0 ]; then
  command -v npm >/dev/null 2>&1 || { echo "missing: npm (nodejs.org)" >&2; exit 1; }
  command -v node >/dev/null 2>&1 || { echo "missing: node (nodejs.org)" >&2; exit 1; }
fi
[ -f .env ] || { echo "missing .env (copy .env.example)" >&2; exit 1; }

# Load .env without echoing secrets.
set -a
# shellcheck disable=SC1091
source ./.env
set +a

export PORT="${PORT:-3000}"
export BACKEND_PORT="$PORT"
# Canonical database: the bare relative default depends on the launch
# directory (root vs apps/ spawned two empty DBs). Pin absolute unless the
# user configured an explicit absolute path or URL.
case "${DATABASE_URL:-}" in
  ""|sqlite:knowledgeable.db)
    export DATABASE_URL="sqlite:$ROOT_DIR/knowledgeable.db"
    ;;
  sqlite:*)
    # Leave custom relative paths alone only if they already point elsewhere.
    if [ "$DATABASE_URL" = "sqlite:apps/knowledgeable.db" ]; then
      export DATABASE_URL="sqlite:$ROOT_DIR/knowledgeable.db"
    fi
    ;;
esac
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=4096}"

pids=()
cleanup() {
  for pid in "${pids[@]:-}"; do
    kill "$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}
trap cleanup INT TERM EXIT

# Stale servers from earlier runs squat the ports and cause exactly the
# confusing failure where the backend can't bind and Vite wanders off to a
# random port while we advertise :3090. Reclaim both up front.
if command -v fuser >/dev/null 2>&1; then
  echo "Freeing ports $PORT and 3090 from previous runs..."
  fuser -k "$PORT/tcp" 3090/tcp > /dev/null 2>&1 || true
  sleep 1
fi

echo "== backend :$PORT (DATABASE_URL=$DATABASE_URL) =="
cargo run -q -p api --bin server &
pids+=($!)

if [ "$BACKEND_ONLY" -eq 0 ]; then
  if [ ! -d apps/web/node_modules ]; then
    echo "== installing web workspace (one-time) =="
    (cd apps/web && npm install --no-audit --no-fund)
  fi
  echo "== web client :3090 (proxy /api -> :$BACKEND_PORT) =="
  # NOTE: PORT is the *backend* port from .env; Vite must not inherit it
  # (it would collide and wander to a random port). Pin Vite explicitly.
  (cd apps/web && PORT=3090 npm run dev) &
  pids+=($!)
fi

echo "Waiting for services..."
for i in $(seq 1 90); do
  BACKEND_OK=0
  WEB_OK=1
  curl -sf "http://localhost:$PORT/health" > /dev/null 2>&1 && BACKEND_OK=1
  if [ "$BACKEND_ONLY" -eq 0 ]; then
    WEB_OK=0
    curl -sf http://localhost:3090/ > /dev/null 2>&1 && WEB_OK=1
  fi
  if [ "$BACKEND_OK" -eq 1 ] && [ "$WEB_OK" -eq 1 ]; then
    break
  fi
  # Fail fast if either child died.
  for pid in "${pids[@]}"; do
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "ERROR: a service died during startup — see output above." >&2
      exit 1
    fi
  done
  sleep 2
  if [ "$i" -eq 90 ]; then
    echo "ERROR: services did not come up (backend=$BACKEND_OK web=$WEB_OK)." >&2
    exit 1
  fi
done

echo "ready: backend http://localhost:$PORT/health"
[ "$BACKEND_ONLY" -eq 0 ] && echo "ready: web     http://localhost:3090/"
wait
